# Environment Configuration

# ── Data & Model Storage ───────────────────────────────────────────────────
# Directory where raw OHLCV Parquet files are stored.
DATA_DIR=data/raw

# Directory where trained .joblib model files are saved.
MODEL_DIR=models/saved

# ── CoinGecko API ──────────────────────────────────────────────────────────
# Base URL for the CoinGecko v3 REST API.
# Override in tests to point at a local mock server.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Number of trailing calendar days of price history to fetch.
HISTORY_DAYS=730

# ── HTTP Client ────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# ── XGBoost Hyperparameters ────────────────────────────────────────────────
XGB_N_ESTIMATORS=500
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.05
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8
XGB_RANDOM_STATE=42
